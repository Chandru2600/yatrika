# ==============================================================================
# Yatrika (TravelPlannerAgent) Environment Configuration Template
# Copy this file to .env and populate your environment-specific credentials.
# ==============================================================================

# ── Flask Server Settings ────────────────────────────────────────────────────
FLASK_ENV=development
PORT=5000
# REQUIRED: Must be set in development and production (minimum 32 random characters)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-32-bytes-minimum

# ── CORS Settings ────────────────────────────────────────────────────────────
# Comma-separated list of permitted origins. Do NOT use "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5001,http://127.0.0.1:5001

# ── Database ─────────────────────────────────────────────────────────────────
# Path to SQLite database file. Defaults to backend/database/travel_planner.db
# DATABASE_PATH=/path/to/custom_travel_planner.db

# ── IBM watsonx.ai (Granite Foundation Model) ────────────────────────────────
# Optional: The platform runs with 100% offline local ML models and curated
# Indian destination intelligence if IBM credentials are not provided.
IBM_API_KEY=your_ibm_cloud_api_key_here
IBM_PROJECT_ID=your_watsonx_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-4-h-small

# ── OpenWeatherMap API ───────────────────────────────────────────────────────
# Optional: Used for real-time 5-day weather forecasts and packing advisories.
# Sign up at: https://home.openweathermap.org/users/sign_up
WEATHER_API_KEY=your_openweathermap_api_key_here

# ── Currency Exchange API ────────────────────────────────────────────────────
# Optional: Real-time forex rates via https://www.exchangerate-api.com/
EXCHANGE_API_KEY=your_exchangerate_api_key_here

# ── Optional Transit Live APIs ───────────────────────────────────────────────
# Optional connectors for live train PNR/schedule, flight search, and state bus
# RAILWAY_AI_API_KEY=
# FLIGHT_API_KEY=
# KSRTC_API_KEY=
